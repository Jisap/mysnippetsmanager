generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider  = "postgresql"
    url       = env("DATABASE_URL")
    directUrl = env("DIRECT_URL")
}

model Snippet {
    id          String   @id @default(uuid())
    title       String
    slug        String   @unique
    description String?
    code        String
    language    String
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    tags Tag[]

    @@index([slug])
}

model Tag {
    id       String    @id @default(uuid())
    name     String    @unique
    snippets Snippet[]

    @@index([name])
}
